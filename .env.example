# API base URL (no trailing slash)
# Destinations: GET {NEXT_PUBLIC_API_URL}/api/v1/public/destinations
# Routes: GET {NEXT_PUBLIC_API_URL}/api/v1/public/routes
NEXT_PUBLIC_API_URL=http://localhost:9000

# Socket.IO server URL for real-time seat updates (optional)
# When not set or no token, seats work in local-only mode for public users
NEXT_PUBLIC_SOCKET_URL=http://localhost:9000

# Optional: JWT for real-time seat holds. When set, enables server-side hold/release.
# For public users without signup, leave unset - seats work locally.
# NEXT_PUBLIC_DEFAULT_TOKEN=Bearer your-jwt-token-here
